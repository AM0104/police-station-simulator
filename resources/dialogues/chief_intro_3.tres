[gd_resource type="Resource" script_class="DialogueLine" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/dialogue_line.gd" id="1_dialogue"]

[resource]
script = ExtResource("1_dialogue")
speaker = "Chief Arkady"
text = "And if anyone asks what you saw down here, you saw nothing. Understood?"
speaker_ru = "Начальник Аркадий"
text_ru = "И если кто-нибудь спросит, что ты здесь видел, — ты ничего не видел. Понял?"
event_name = "start_quest"
event_payload = "take_folder"
