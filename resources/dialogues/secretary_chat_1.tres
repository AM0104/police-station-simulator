[gd_resource type="Resource" script_class="DialogueLine" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/dialogue_line.gd" id="1_dialogue"]

[resource]
script = ExtResource("1_dialogue")
speaker = "Anna Belova"
text = "The Chief is in. He is always in. I would not keep him waiting."
speaker_ru = "Анна Белова"
text_ru = "Начальник у себя. Он всегда у себя. Я бы не заставляла его ждать."
