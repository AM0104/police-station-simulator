[resource]
script = ExtResource("1_dialogue")
speaker = "Chief Arkady"
text = "Take these folders to my office upstairs. The Kravtsov file stays in the archive. Don't be late."
speaker_ru = "Начальник Аркадий"
text_ru = "Отнеси эти папки в мой кабинет наверху. Дело Кравцова остаётся в архиве. Не опаздывай."
next_line = ExtResource("2_next")
